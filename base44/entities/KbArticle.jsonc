{
  "name": "KbArticle",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "title": "Question"
    },
    "answer": {
      "type": "string",
      "title": "Answer (markdown)"
    },
    "category": {
      "type": "string",
      "enum": [
        "Lost Keys & Security",
        "Electrical & Diagnostics",
        "Performance & Tuning",
        "Mail-In Service",
        "Pricing & Warranty"
      ],
      "title": "Category"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Order"
    }
  },
  "required": [
    "question",
    "answer",
    "category"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}