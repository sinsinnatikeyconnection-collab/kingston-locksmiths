{
  "name": "LoyaltyTransaction",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email",
      "title": "Owner Email"
    },
    "owner_email_lower": {
      "type": "string",
      "title": "Owner Email Lower"
    },
    "points": {
      "type": "number",
      "title": "Points (signed)"
    },
    "reason": {
      "type": "string",
      "title": "Reason"
    },
    "reference": {
      "type": "string",
      "title": "Reference"
    }
  },
  "required": [
    "owner_email",
    "points",
    "reason"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.owner_email_lower": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}