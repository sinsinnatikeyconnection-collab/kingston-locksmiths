{
  "name": "CaseStudy",
  "type": "object",
  "properties": {
    "image_url": {
      "type": "string",
      "title": "Image URL"
    },
    "side": {
      "type": "string",
      "enum": [
        "Digital",
        "Physical"
      ],
      "default": "Digital",
      "title": "Side"
    },
    "title": {
      "type": "string",
      "title": "Title"
    },
    "tag": {
      "type": "string",
      "title": "Tag"
    },
    "order": {
      "type": "number",
      "default": 0,
      "title": "Order"
    }
  },
  "required": [
    "image_url",
    "side",
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}