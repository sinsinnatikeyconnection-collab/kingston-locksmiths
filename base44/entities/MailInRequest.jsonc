{
  "name": "MailInRequest",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "title": "Customer Name"
    },
    "customer_email": {
      "type": "string",
      "format": "email",
      "title": "Customer Email"
    },
    "customer_phone": {
      "type": "string",
      "title": "Customer Phone"
    },
    "item_type": {
      "type": "string",
      "enum": [
        "Instrument Cluster",
        "ECU / Module",
        "Keys / Fobs",
        "Engine / Long Block",
        "Transmission",
        "Wheels / Tires",
        "Full Vehicle / Pickup",
        "Other"
      ],
      "title": "Item Type"
    },
    "vehicle": {
      "type": "string",
      "title": "Vehicle"
    },
    "problem": {
      "type": "string",
      "title": "Problem"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "label_ready",
        "shipped",
        "received",
        "in_progress",
        "shipped_back",
        "completed"
      ],
      "default": "requested",
      "title": "Status"
    },
    "tracking_number": {
      "type": "string",
      "title": "Tracking Number"
    },
    "label_pdf_url": {
      "type": "string",
      "title": "Label Pdf Url"
    },
    "idempotency_key": {
      "type": "string",
      "title": "Idempotency Key"
    }
  },
  "required": [
    "customer_name",
    "customer_email",
    "item_type",
    "vehicle",
    "problem"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}