{
  "name": "LoyaltyAccount",
  "type": "object",
  "properties": {
    "owner_email": {
      "type": "string",
      "format": "email",
      "title": "Owner Email"
    },
    "owner_email_lower": {
      "type": "string",
      "title": "Owner Email Lower"
    },
    "points_balance": {
      "type": "number",
      "default": 0,
      "title": "Points Balance"
    },
    "lifetime_points": {
      "type": "number",
      "default": 0,
      "title": "Lifetime Points"
    },
    "tier": {
      "type": "string",
      "enum": [
        "bronze",
        "silver",
        "gold",
        "platinum"
      ],
      "default": "bronze",
      "title": "Tier"
    },
    "last_earned_date": {
      "type": "string",
      "format": "date",
      "title": "Last Earned Date"
    }
  },
  "required": [
    "owner_email",
    "points_balance",
    "lifetime_points",
    "tier"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "data.owner_email_lower": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}